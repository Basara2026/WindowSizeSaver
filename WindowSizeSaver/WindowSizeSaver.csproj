<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WPF の Fluent テーマ(ThemeMode)は .NET 9 以降が必要 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <!-- 通知領域アイコン(NotifyIcon)だけに WinForms を使用 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WindowSizeSaver</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>WindowSizeSaver</RootNamespace>
    <!-- ThemeMode は試験的 API の警告(WPF0001)が出るため抑制 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF と WinForms の型名衝突を避ける -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- 通知領域アイコンと設定画面のアイコンとして読み込む -->
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
